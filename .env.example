# Solar Panel Degradation Predictor - environment variables
#
# Copy this file to .env and fill in values before running the app.
# Variables read directly by the application or its entry point.

# ----- Required ---------------------------------------------------------------

# Flask session-signing key. Must be secret and unpredictable in production.
# Read by: app/config.py  ->  Config.SECRET_KEY
# Generate a strong key with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-generated-secret

# ----- Optional (safe defaults apply if omitted) ------------------------------

# Configuration profile selected by run.py.
# Allowed values: development | production (default) | testing
# Read by: run.py  ->  os.environ.get('FLASK_ENV', 'production')
FLASK_ENV=development

# SQLAlchemy database connection URL.
# Read by: app/config.py  ->  Config.SQLALCHEMY_DATABASE_URI
# Default (SQLite, no server needed): the file is created automatically
#   at instance/app.db on first run, regardless of current working directory.
# MySQL example:    DATABASE_URL=mysql+pymysql://user:pass@localhost/solar_db
# Postgres example: DATABASE_URL=postgresql://user:pass@localhost/solar_db
DATABASE_URL=sqlite:///app.db

# Optional: set true when serving over HTTPS. Defaults to true in production
# and false for local development.
COOKIE_SECURE=false

# Optional: trust exactly one proxy for forwarded client information.
# Only enable this behind one known, trusted reverse proxy.
TRUST_PROXY=false
