# Solar Panel Degradation Predictor - environment variables
#
# Copy this file to .env and fill in values before running the app.
# Only variables listed here are read by the application.
# All others (e.g. FLASK_DEBUG) are not read and should not be added.

# ----- Required ---------------------------------------------------------------

# Flask session-signing key. Must be secret and unpredictable in production.
# Read by: app/config.py  ->  Config.SECRET_KEY
# Generate a strong key with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-key-change-in-production

# ----- Optional (safe defaults apply if omitted) ------------------------------

# Configuration profile selected by run.py.
# Allowed values: development (default) | production | testing
# Read by: run.py  ->  os.environ.get('FLASK_ENV', 'development')
FLASK_ENV=development

# SQLAlchemy database connection URL.
# Read by: app/config.py  ->  Config.SQLALCHEMY_DATABASE_URI
# Default (SQLite, no server needed): the file is created automatically
#   at instance/app.db on first run.
# MySQL example:    DATABASE_URL=mysql+pymysql://user:pass@localhost/solar_db
# Postgres example: DATABASE_URL=postgresql://user:pass@localhost/solar_db
DATABASE_URL=sqlite:///app.db

